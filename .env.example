# Copy to .env (`make up` does this for you). Host-side values: tests and the CLI use localhost.
# Inside Docker Compose, infra/docker-compose.yml overrides the service addresses.

DATABASE_URL=postgresql+asyncpg://chefos_app:chefos_app@localhost:5432/chefos
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://chefos_owner:chefos_owner@localhost:5432/chefos
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=chefos
S3_SECRET_KEY=chefos-dev-secret
S3_BUCKET=chefos-raw

# base64, 32 bytes. `make up` generates one if this is empty.
CHEFOS_MASTER_KEY=
CHEFOS_MASTER_KEY_ID=local-1

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# true outside localhost
SESSION_COOKIE_SECURE=false
# local | test. Dev-only routes require local.
ENV=local

# Square integration (used by the integrations module)
# fake = simulated sandbox, no credentials needed. sandbox = real Square sandbox.
SQUARE_MODE=fake
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Where the browser app lives (OAuth redirects go here)
WEB_ORIGIN=http://localhost:3000
# Incremental sync cadence
SYNC_INTERVAL_SECONDS=60
